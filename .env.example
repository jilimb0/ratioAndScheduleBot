# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Default fallback timezone
TIMEZONE=Europe/Moscow

# Server settings
PORT=8000
USE_WEBHOOK=false
WEBHOOK_URL=https://ratioandschedulebot.onrender.com/webhook

# SQLite Database path
DATABASE_PATH=bot_data.db

# Telegram Stars Pro Subscription settings
PRO_PRICE_STARS=150

# WebApp URL (optional, if hosted on external domain or Render URL)
WEBAPP_URL=https://ratioandschedulebot.onrender.com/webapp
